# GoalBuddies — kopieer naar .env en vul in. .env staat in .gitignore.
#
# ⚠️ Alles met EXPO_PUBLIC_ ervoor komt in de client-bundle terecht en is dus
#    publiek. Zet daar nooit een secret in.

# --- Client (publiek, veilig) -----------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://wehgocadxehottiiyvsc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Het publieke adres van de app, gebruikt in uitnodigingslinks. Laat je hem leeg,
# dan wordt het productieadres gebruikt — en dan wijst een link uit een
# testomgeving naar productie.
EXPO_PUBLIC_APP_URL=https://goalbuddies.q-projects.tech

# --- Server (geheim, nooit client-side) -------------------------------------
# Alleen voor Edge Functions en de RLS-testsuite. Deze key omzeilt RLS volledig.
SUPABASE_SERVICE_ROLE_KEY=

# Directe databaseverbinding, voor pg_dump vóór een migratie.
SUPABASE_DB_URL=

# Personal access token voor de Management API — https://supabase.com/dashboard/account/tokens
# Alleen voor scripts/auth-urls.mjs, dat de Site URL en de redirect-URL's zet.
#
# ⚠️ Dit is NIET de service-role-key; die werkt niet op de Management API. En hij
#    geeft toegang tot je hele Supabase-account, niet alleen tot dit project.
SUPABASE_ACCESS_TOKEN=

# Het JWT-secret van het project — dashboard, Settings → API → JWT Settings.
# Alleen voor de RLS-testsuite: die tekent de gebruikerstokens er zelf mee in
# plaats van in te loggen (QS8-116). Nooit client-side, nooit in CI.
SUPABASE_JWT_SECRET=

# AI-provider voor de Doelcoach (EPIC 3). Nooit client-side.
ANTHROPIC_API_KEY=

# --- Web push (QS8-114) ------------------------------------------------------
# Het VAPID-sleutelpaar waarmee de server zich bij de pushdienst legitimeert.
# Eenmalig genereren met genereerVapidSleutelpaar() uit
# src/modules/notifications/webpush-crypto.ts.
#
# ⚠️ Een nieuw paar maakt élk bestaand abonnement ongeldig: de browser bindt een
#    abonnement aan de publieke sleutel waarmee het is aangemaakt. Roteren
#    betekent dus dat iedereen opnieuw toestemming moet geven.
#
# De publieke helft is bedoeld om publiek te zijn — die gaat als
# applicationServerKey mee in de client, en heet daarom EXPO_PUBLIC_.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# ⚠️ De privésleutel hoort ALLEEN in de omgeving van de Edge Function
#    (`supabase secrets set`), niet in de webbuild. Het voorvoegsel is hier de
#    hele bescherming: Expo bakt uitsluitend EXPO_PUBLIC_-variabelen in de
#    bundel, dus zolang deze naam dat voorvoegsel niet heeft, komt hij er niet in.
#
#    ⚠️ Er is GEEN secret-scan die dit afvangt. Tot 23-08-2026 stond hier dat
#       `scripts/deploy-web.mjs` dat deed; dat bestand bestaat niet en heeft
#       nooit bestaan. Wie dit leest en denkt dat er een vangnet is, plakt de
#       sleutel een keer verkeerd en merkt het niet. Zie docs/ENGINEER-REVIEW.md.
VAPID_PRIVATE_KEY=

# Het adres waarop de pushdienst de beheerder kan bereiken bij misbruik.
# Moet een mailto:- of https:-adres zijn (RFC 8292); een lege of verzonnen
# waarde is voor de pushdienst een reden om te weigeren.
VAPID_SUBJECT=mailto:quinten.strijdonk@gmail.com

# --- Observability ----------------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=

# --- Tests -------------------------------------------------------------------
# De RLS-tests maken echte accounts aan en ruimen ze op met de service-role-key.
# Zolang er geen lokale Supabase-stack is, wijzen ze naar het echte project.
# Zet dit op 1 om ze bewust daar te laten draaien.
RLS_TEST_ALLOW_PROD=
