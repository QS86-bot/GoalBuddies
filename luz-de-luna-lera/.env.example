# Kopieer naar .env en vul aan. `.env` staat in .gitignore en komt nooit uit de repo.
#
# ⚠️ Alles wat de browser kan lezen (de Bolt-export) mag alleen PUBLIEKE waarden
#    dragen. Een geheim dat in de webbundel belandt, is publiek vanaf de eerste
#    deploy — ook als je het daarna weghaalt.

# --- Supabase (project: nog aan te maken, regio eu-west, gratis tier) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=                 # publiek; draait volledig onder RLS
SUPABASE_SERVICE_ROLE_KEY=         # ⚠️ omzeilt RLS — alleen server (n8n, functies), nooit in web/
SUPABASE_DB_URL=                   # directe verbinding, alleen voor pg_dump vóór een migratie

# --- n8n ---
N8N_BASE_URL=                      # het adres van de n8n-instantie
N8N_WEBHOOK_SECRET=                # gedeeld geheim waarmee de site n8n-webhooks aanroept

# --- AI-personalisatie (de uitgebreide spiegel en de funnelmails) ---
ANTHROPIC_API_KEY=                 # server-only; kosten loggen per aanroep

# --- Betalen (besluit uit docs/research/betalen-mollie.md) ---
MOLLIE_API_KEY=                    # test_... tot de betaalpagina live mag
MOLLIE_WEBHOOK_URL=

# --- Agenda ---
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=       # pad naar het sleutelbestand, niet de inhoud

# --- E-mail (verzendkanaal volgt uit docs/research/privacy-avg.md) ---
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# --- Hosting ---
HOSTINGER_FTP_HOST=
HOSTINGER_FTP_USER=
HOSTINGER_FTP_PASSWORD=
